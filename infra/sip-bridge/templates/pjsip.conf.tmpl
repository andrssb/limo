[global]
type=global
user_agent=Limo-SIP-Bridge
endpoint_identifier_order=auth_username,ip,username,anonymous

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
external_signaling_address=${PUBLIC_IPV4}
external_signaling_port=5060
external_media_address=${PUBLIC_IPV4}
local_net=127.0.0.0/8
local_net=10.0.0.0/8
local_net=172.16.0.0/12
local_net=192.168.0.0/16

[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:5060
external_signaling_address=${PUBLIC_IPV4}
external_signaling_port=5060
external_media_address=${PUBLIC_IPV4}
local_net=127.0.0.0/8
local_net=10.0.0.0/8
local_net=172.16.0.0/12
local_net=192.168.0.0/16

; ElevenLabs autentica o INVITE de saida contra este endpoint.
[elevenlabs-auth]
type=auth
auth_type=userpass
username=${EL_SIP_USERNAME}
password=${EL_SIP_PASSWORD}

; No primeiro INVITE ainda nao existe Authorization, entao o endpoint
; anonymous envia o desafio Digest. Na repeticao, auth_username identifica o
; endpoint nomeado abaixo sem depender de IP fixo da ElevenLabs.
[anonymous]
type=endpoint
transport=transport-tcp
context=from-elevenlabs
disallow=all
allow=alaw
allow=ulaw
allow=g722
auth=elevenlabs-auth
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
timers=no

[${EL_SIP_USERNAME}]
type=endpoint
transport=transport-tcp
context=from-elevenlabs
disallow=all
allow=alaw
allow=ulaw
allow=g722
auth=elevenlabs-auth
identify_by=auth_username
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
timers=no

; Registro permanente exigido pela Vono.
[vono-auth]
type=auth
auth_type=userpass
username=${VONO_USERNAME}
password=${VONO_PASSWORD}

[vono-aor]
type=aor
contact=sip:${VONO_DOMAIN}:5060

[vono]
type=endpoint
transport=transport-udp
context=from-vono
disallow=all
allow=alaw
allow=ulaw
outbound_auth=vono-auth
aors=vono-aor
from_user=${VONO_USERNAME}
from_domain=${VONO_DOMAIN}
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
send_pai=yes
trust_id_outbound=yes
timers=no

[vono-registration]
type=registration
transport=transport-udp
outbound_auth=vono-auth
server_uri=sip:${VONO_DOMAIN}:5060
client_uri=sip:${VONO_USERNAME}@${VONO_DOMAIN}
contact_user=${VONO_USERNAME}
retry_interval=30
forbidden_retry_interval=300
fatal_retry_interval=300
auth_rejection_permanent=no
max_retries=100000
max_random_initial_delay=0
expiration=600
line=yes
endpoint=vono

; Rota opcional para chamadas recebidas da Vono chegarem ao agente.
[elevenlabs-cloud-aor]
type=aor
contact=sip:sip.rtc.elevenlabs.io:5060

[elevenlabs-cloud]
type=endpoint
transport=transport-tcp
context=from-elevenlabs-cloud
disallow=all
allow=alaw
allow=ulaw
allow=g722
aors=elevenlabs-cloud-aor
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
timers=no
