{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile"
  },
  "deploy": {
    "preDeployCommand": "node node_modules/tsx/dist/cli.mjs packages/db/src/migrate.ts",
    "startCommand": "node node_modules/tsx/dist/cli.mjs apps/api/src/index.ts",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
