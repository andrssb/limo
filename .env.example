# ─── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://limo:SENHA_FORTE@localhost:5432/limo_db
POSTGRES_USER=limo
POSTGRES_PASSWORD=SENHA_FORTE
POSTGRES_DB=limo_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:SENHA_REDIS@localhost:6379
REDIS_PASSWORD=SENHA_REDIS

# ─── JWT (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ──
JWT_SECRET=GERE_UMA_CHAVE_DE_48_BYTES_AQUI
JWT_REFRESH_SECRET=GERE_OUTRA_CHAVE_DE_48_BYTES_AQUI
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Encryption (32 bytes exatos) ─────────────────────────────────────────────
ENCRYPTION_KEY=EXATAMENTE_32_CARACTERES_AQUI!!!

# ─── IA (Groq — gratuito em console.groq.com) ─────────────────────────────────
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ANTHROPIC_API_KEY=sk-ant-placeholder
OPENAI_API_KEY=sk-placeholder

# ─── Storage de audio (MinIO local ou S3 na AWS) ──────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=limo_minio
STORAGE_SECRET_KEY=limo_minio_secret
STORAGE_BUCKET=limo-audio
STORAGE_REGION=us-east-1
MINIO_USER=limo_minio
MINIO_PASSWORD=limo_minio_secret

# ─── Email (Resend — gratuito em resend.com, 3000 emails/mes) ─────────────────
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EMAIL_FROM=Limo <noreply@seudominio.com.br>

# ─── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://app.seudominio.com.br
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=production

# ─── SDR IA por voz (piloto; desligado por padrão) ───────────────────────────
VOICE_SDR_ENABLED=false
VOICE_SDR_LIVE_CALLS=false
VOICE_SDR_DAILY_LIMIT=10
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_TOOL_SECRET=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
SIP_BRIDGE_HEALTH_URL=
SIP_BRIDGE_HEALTH_TIMEOUT_MS=3000
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://api.seudominio.com.br/v1/voice-sdr/calendar/google/callback
GOOGLE_CALENDAR_ACCOUNT=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_MEETING_MINUTES=45

# ─── CRM (opcional) ───────────────────────────────────────────────────────────
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=https://app.seudominio.com.br/oauth/hubspot
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
PIPEDRIVE_REDIRECT_URI=https://app.seudominio.com.br/oauth/pipedrive
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
